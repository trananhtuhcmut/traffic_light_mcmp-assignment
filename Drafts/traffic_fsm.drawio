        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n[*] --&gt; MODE_MANUAL : Mode change (button 1) from MODE_AUTO\n\nstate MODE_MANUAL {\n  state \&quot;R1 - G2 (MAN)\&quot; as R1_G2\n  state \&quot;R1 - Y2 (BUFFER)\&quot; as R1_Y2\n  state \&quot;G1 - R2 (MAN)\&quot; as G1_R2\n  state \&quot;Y1 - R2 (BUFFER)\&quot; as Y1_R2\n\n  [*] --&gt; R1_G2\n\n  R1_G2 : entry/\n  R1_G2 : R1 on, G2 on\n\n  R1_G2 --&gt; R1_Y2 : SWITCH_LIGHT /\n\n  R1_Y2 : entry/\n  R1_Y2 : G2 off, Y2 on\n  R1_Y2 : load Y2_dur\n  R1_Y2 :\n  R1_Y2 : TICK_1s [Y2_timer &gt; 0]/\n  R1_Y2 : Y2_dur--\n\n  R1_Y2 --&gt; G1_R2 : TICK_1S [else]/\n\n  G1_R2 : entry/\n  G1_R2 : R1 off, G1 on, Y2 off, R2 on\n\n  G1_R2 --&gt; Y1_R2 : SWITCH_LIGHT /\n\n  Y1_R2 : entry/\n  Y1_R2 : G1 off, Y1 on\n  Y1_R2 : load Y1_dur\n  Y1_R2 :\n  Y1_R2 : TICK_1s [Y1_timer &gt; 0]/\n  Y1_R2 : Y1_dur--\n\n  Y1_R2 --&gt; R1_G2 : TICK_1S [else]/\n}\n\nMODE_MANUAL --&gt; [*] : Mode change (button 1) to MODE_SETTING\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ic6Nao8f41JtbyAwe6FB-1">
